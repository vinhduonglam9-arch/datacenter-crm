{
  "name": "datacenter-crm",
  "productName": "数据中心CRM系统",
  "version": "1.0.0",
  "description": "数据中心项目客户关系管理系统 - 离线CPU名片OCR与智算拓扑协作平台",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "bundle:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=server.mjs --external:express --external:@google/genai --external:dotenv --external:vite --external:sql.js",
    "pack:installer": "pnpm run build && pnpm run bundle:server && electron-builder --win nsis",
    "pack:dir": "pnpm run build && pnpm run bundle:server && electron-builder --win dir",
    "clean": "rm -rf dist server.mjs installer-dist",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.datacenter.crm",
    "productName": "数据中心CRM系统",
    "directories": {
      "output": "installer-dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "bin/**/*",
      "models/**/*",
      "node_modules/express/**/*",
      "node_modules/@google/**/*",
      "node_modules/dotenv/**/*",
      "node_modules/sql.js/**/*",
      "server.mjs",
      "package.json"
    ],
    "asar": false,
    "win": {
      "executableName": "数据中心CRM系统",
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "数据中心CRM系统",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "DataCenter-CRM-${version}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.15.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
